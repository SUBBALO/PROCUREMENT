# ── Frontend Environment ────────────────────────────────────────────
# Salin file ini menjadi `.env` (di folder frontend) lalu isi nilainya.
#   cp env.example .env
# PENTING: nilai ini "dibekukan" saat `yarn build`. Set SEBELUM build.

# Alamat backend API (samakan dengan server backend Anda)
REACT_APP_BACKEND_URL=http://192.168.1.254:8001

# ── Opsional (hanya untuk dev server `yarn start`) ──────────────────
# WDS_SOCKET_PORT=443
# ENABLE_HEALTH_CHECK=true
