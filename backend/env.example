# ── Backend Environment ─────────────────────────────────────────────
# Salin file ini menjadi `.env` (di folder backend) lalu isi nilainya.
#   cp env.example .env
# CATATAN: file .env TIDAK ikut ke GitHub (sengaja, demi keamanan rahasia).

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=mks_erp

# CORS: origin frontend (samakan dengan alamat web Anda)
CORS_ORIGINS=http://192.168.1.254:3000

# Keamanan
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Akun awal (dibuat otomatis saat startup bila belum ada)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-kuat
SUPER_ADMIN_USERNAME=susanto

# ── Opsional ─────────────────────────────────────────────────────────
# Path binari LibreOffice (jika tidak terdeteksi otomatis)
# SOFFICE_BIN=/usr/bin/soffice
# Fitur AI (bila dipakai)
# GEMINI_API_KEY=
